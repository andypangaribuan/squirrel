#: check the code with cargo check, build, clippy and fmt
function check {
  cargo check
  cargo build
  cargo clippy && cargo fmt --check
}


#: clean the project
function clean {
  cargo clean
}


#: do cargo test
function test {
  cargo test -q -- --test-threads=1
}


#: run cspell to check the project words
function spell {
  spell-rs
}


#: space


#: open devbox shell #: opt: --fresh (delete .cargo and .rustup directories first)
function shell {
  if [ "$DEVBOX_SHELL_ENABLED" = "1" ]; then
    echo "ℹ️  You are already in an active Devbox shell."
    return 0
  fi

  if [[ $1 == "--fresh" ]]; then
    rm -rf .cargo .rustup
  fi

  DEVBOX_PROJECT_CWD="$PWD" devbox shell --config ~/.devbox/global/rust-1.98/devbox.json
}


#: show unused dependencies
function udeps {
  cargo +nightly udeps
}


#: remove unused directories
function rmd {
  # rm -rf .cargo .devbox .rustup debug target test-debug
  echo "hey"
}


#: space


#: build the cli app
function build {
  mkdir -p .releases
  rm -rf .releases/sq-darwin-arm64
  cargo build --release
  mv target/release/sq .releases/sq-darwin-arm64
  chmod +x .releases/sq-darwin-arm64
  rm -rf target
}

#: build the cli app for linux amd64
function build64 {
  mkdir -p .releases
  rm -rf .releases/sq-linux-x86_64
  rustup target add x86_64-unknown-linux-musl
  cargo install cross --git https://github.com/cross-rs/cross
  cross build --target x86_64-unknown-linux-musl --release
  mv target/x86_64-unknown-linux-musl/release/sq .releases/sq-linux-x86_64 
  chmod +x .releases/sq-linux-x86_64

}


#: build dev and move
function bd {
  cargo build
  cp target/debug/sq /usr/local/bin/sq
}


#: move sq into /usr/local/bin/sq
function move {
  sudo cp .releases/sq /usr/local/bin/sq
}


#: use old sq
function old {
  # sudo rm -rf /usr/local/bin/sqo && \
  # sudo curl -L https://github.com/andypangaribuan/squirrel/releases/latest/download/sq-`uname -s`-`uname -m` -o /usr/local/bin/sqo && \
  # sudo chmod +x /usr/local/bin/sqo

  sudo cp /usr/local/bin/sqo /usr/local/bin/sq
}


#: space
[ -z "$TASKFILE_EXECUTOR" ] && sq taskfile --execute "$@"
