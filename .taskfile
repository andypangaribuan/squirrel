function main {
  local options=(
    "check          check the code with cargo check, build, clippy and fmt"
    "test           run tests"
    "spell          run cspell to check the project words"
    "clean          clean the project"
    "rmd            remove unused directories"
    "udeps          show unused dependencies"
    ""
    "release        build the release version of sq cli"
    "release-linux  build the release version of sq cli for linux os"
    "debug          build the debug version of sq cli"
    "cp-release     copy the sq release version into local machine"
    "cp-debug       copy sq debug version into local machine"
    ""
    "shell          open devbox shell        [opt]: --fresh (delete .cargo and .rustup directories first)"
  )

  local selected="$1"
  if [[ -z "$selected" ]]; then
    selected=$(sq choose "$1" "options: " "${options[@]}")
  fi
  [[ -z "$selected" ]] && return 0

  case "$selected" in
    check) __run_devbox sh -c 'cargo check && cargo build && cargo clippy && cargo fmt --check' ;;
    test)  __run_devbox cargo test -q -- --test-threads=1 ;;
    spell) spell-rs ;;
    clean) __run_devbox cargo clean ;;
    rmd)   rm -rf .cargo .devbox .rustup debug target test-debug ;;
    udeps) __run_devbox cargo +nightly udeps ;;

    release)
      mkdir -p .releases
      rm -rf .releases/sq-darwin-arm64
      __run_devbox cargo build --release || exit 1
      mv target/release/sq .releases/sq-darwin-arm64
      chmod +x .releases/sq-darwin-arm64
      codesign -s - -f .releases/sq-darwin-arm64
      rm -rf target
      ;;

    release-linux)
      mkdir -p .releases
      rm -rf .releases/sq-linux-x86_64
      __run_devbox sh -c 'rustup target add x86_64-unknown-linux-musl && cargo install cross --git https://github.com/cross-rs/cross && cross build --target x86_64-unknown-linux-musl --release' || exit 1
      mv target/x86_64-unknown-linux-musl/release/sq .releases/sq-linux-x86_64
      chmod +x .releases/sq-linux-x86_64
      rm -rf target
      ;;

    debug)      __run_devbox cargo build ;;
    cp-release)
      sudo rm -f /usr/local/bin/sq
      sudo cp .releases/sq-darwin-arm64 /usr/local/bin/sq
      sudo codesign -s - -f /usr/local/bin/sq
      ;;
    cp-debug)
      sudo rm -f /usr/local/bin/sq
      sudo cp target/debug/sq /usr/local/bin/sq
      sudo codesign -s - -f /usr/local/bin/sq
      ;;

    shell) __shell "$2" ;;

    *) echo "unknown option: $selected" ;;
  esac
}


function __run_devbox {
  local root_dir
  root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  if [ "$DEVBOX_SHELL_ENABLED" = "1" ]; then
    "$@"
  else
    DEVBOX_PROJECT_CWD="${root_dir}" devbox run --config ~/.devbox/global/rust-1.100/devbox.json -- "$@"
  fi
}


function __shell {
  if [ "$DEVBOX_SHELL_ENABLED" = "1" ]; then
    echo "ℹ️  You are already in an active Devbox shell."
    return 0
  fi

  if ! __is_nix_daemon_running; then
    echo "🔄 Nix daemon is not running. Attempting to start Nix daemon..."

    if ! __start_nix_daemon; then
      echo "❌ Failed to start the Nix daemon."
      exit 1
    fi

    local retries=25
    while ! __is_nix_daemon_running && (( retries > 0 )); do
      sleep 0.2
      (( retries-- ))
    done

    if ! __is_nix_daemon_running; then
      echo "❌ Failed to verify the Nix daemon is running. Please check /var/log/determinate-nix-daemon.log."
      exit 1
    fi

    echo "✅ Verified Nix daemon is running."
  fi

  if [[ $1 == "--fresh" ]]; then
    rm -rf .cargo .rustup
  fi

  if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]]; then
    local user_home
    user_home=$(eval echo "~${SUDO_USER}")
    sudo -u "$SUDO_USER" -H env DEVBOX_PROJECT_CWD="$PWD" devbox shell --config "${user_home}/.devbox/global/rust-1.100/devbox.json"
  else
    DEVBOX_PROJECT_CWD="$PWD" devbox shell --config ~/.devbox/global/rust-1.100/devbox.json
  fi
}


function __is_nix_daemon_running {
  [[ -S /nix/var/nix/daemon-socket/socket || -S /var/run/nix-daemon.socket ]] || return 1

  if command -v launchctl >/dev/null 2>&1; then
    launchctl print system/systems.determinate.nix-daemon >/dev/null 2>&1 \
      || launchctl print system/org.nixos.nix-daemon >/dev/null 2>&1 \
      || return 1
  elif command -v systemctl >/dev/null 2>&1; then
    systemctl is-active --quiet nix-daemon.service 2>/dev/null \
      || systemctl is-active --quiet nix-daemon.socket 2>/dev/null \
      || return 1
  fi

  return 0
}


function __start_nix_daemon {
  local run_prefix=()
  if [[ $EUID -ne 0 ]]; then
    if ! sudo -n true >/dev/null 2>&1; then
      echo "🔒 Root/sudo access is required to start the Nix daemon."
      sudo -v || return 1
    fi
    run_prefix=(sudo)
  fi

  if command -v launchctl >/dev/null 2>&1; then
    local plist=""
    local service=""
    if [[ -f /Library/LaunchDaemons/systems.determinate.nix-daemon.plist ]]; then
      plist="/Library/LaunchDaemons/systems.determinate.nix-daemon.plist"
      service="system/systems.determinate.nix-daemon"
    elif [[ -f /Library/LaunchDaemons/org.nixos.nix-daemon.plist ]]; then
      plist="/Library/LaunchDaemons/org.nixos.nix-daemon.plist"
      service="system/org.nixos.nix-daemon"
    fi

    if [[ -n "$plist" ]]; then
      "${run_prefix[@]}" launchctl bootstrap system "$plist" >/dev/null 2>&1 \
        || "${run_prefix[@]}" launchctl load -w "$plist" >/dev/null 2>&1 \
        || true
      "${run_prefix[@]}" launchctl kickstart -k "$service" >/dev/null 2>&1 || return 1
      return 0
    fi
  elif command -v systemctl >/dev/null 2>&1; then
    "${run_prefix[@]}" systemctl start nix-daemon.socket nix-daemon.service >/dev/null 2>&1 \
      || "${run_prefix[@]}" systemctl start nix-daemon >/dev/null 2>&1 \
      || return 1
    return 0
  fi

  return 1
}


main "$@"
