KYML_NAMESPACE=ns-rc
KYML_APP_NAME=partner-api
KYML_IMAGE_PATH=asia-southeast2-docker.pkg.dev/partner-api
KYML_IMAGE_VERSION=1.0.7.rc1
KYML_HTTP_PORT_NAME=http-port
KYML_HTTP_PORT_NUMBER=10101

KYML_PRIORITY_CLASS=high-priority
KYML_CPU_REQUEST=250m
KYML_MEMORY_REQUEST=256Mi
KYML_EPHEMERAL_STORAGE=100Mi

# safe for linkerD sidecar, refer to https://linkerd.io/docs/tasks/configuring-proxy-concurrency/
KYML_LINKERD_CPU_REQUEST=100m
KYML_LINKERD_CPU_LIMIT=1000m
KYML_LINKERD_MEMORY_REQUEST=128Mi
KYML_LINKERD_MEMORY_LIMIT=512Mi

KYML_POD_SAFE_TO_EVICT=true
KYML_POD_REPLICA=1
KYML_HTTP_PROBE=/healthz

KYML_PDB_MAX_UNAVAILABLE=1

KYML_HPA_MIN_REPLICA=1
KYML_HPA_MAX_REPLICA=2
KYML_HPA_AVG_CPU=80
KYML_HPA_AVG_MEMORY=50

KYML_ING_DOMAIN=api.partner.id


KYML_GCP_PROJECT_ID=global-partner-id
KYML_GCP_DB_REGION=asia-southeast2
KYML_GCP_DB_INSTANCE_ID=id-ark
